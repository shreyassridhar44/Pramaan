# Copy to .env for local development. Never commit .env.

ENVIRONMENT=local
DEMO_MODE=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://pramaan:pramaan@localhost:5432/pramaan
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-only-session-secret-change-me

# local: files under STORAGE_LOCAL_DIR; s3: the bucket below (deployment)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=../../.data/storage
STORAGE_BUCKET=pramaan-docs
AWS_REGION=ap-south-1

# Base64 Ed25519 private key for letter QR tokens. Leave empty locally: one is generated once and
# kept in .data/keys. Required in production (store it in SSM Parameter Store).
LETTER_SIGNING_KEY_B64=
# Origin of the public verify page that letter QR codes point to.
PUBLIC_BASE_URL=http://localhost:5173

EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=Pramaan <no-reply@pramaan.local>

BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=in.anthropic.claude-haiku-4-5-20251001-v1:0

MODELS_DIR=../../ml/models
