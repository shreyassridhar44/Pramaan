# infra/.env for infra/compose.yml. The AWS deploy script writes this file from SSM; for a local
# production-like run, copy it to infra/.env and fill it in. Never commit infra/.env.
POSTGRES_PASSWORD=change-me
SESSION_SECRET=
# python -c "import base64; from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey as K; from cryptography.hazmat.primitives import serialization as s; print(base64.b64encode(K.generate().private_bytes(s.Encoding.Raw, s.PrivateFormat.Raw, s.NoEncryption())).decode())"
LETTER_SIGNING_KEY_B64=
PUBLIC_BASE_URL=http://localhost
# Empty disables the CloudFront origin header check.
ORIGIN_SECRET=
# user:password for the captured inbox at /mail/
MAIL_UI_AUTH=demo:change-me
STORAGE_BACKEND=local
